:root {
}

#Body{
    background-color: #363636;
    border-width: 1px;
    border-color: #595858;
    border-radius: 10px;
    color: #ffffff;
    font-size: 16px;
    padding: 16px;
}

.Title{
    font-size: 24px;
}

#TextFieldWrapper{
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 40px;
}

TextField>TextInput{
    background-color: #4f4f4f;
    border-radius: 10px;
    min-width: 70px;
}

.Suffix{
    font-size: 12px;
}

Button{
    background-color: #4f4f4f;
    border-radius: 10px;
    color: #ffffff;
}