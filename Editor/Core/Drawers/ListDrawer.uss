.ListDrawer {
    flex-grow: 1;
    min-width: 0;
    margin-top: 4px;
    margin-bottom: 8px;
}

.ListDrawer__ScrollView {
    max-height: 400px;
    min-height: 0;
    flex-shrink: 1;
}

.ListDrawer__Item {
    margin-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 8px;
    background-color: rgba(128, 128, 128, 0.08);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(128, 128, 128, 0.25);
    border-right-color: rgba(128, 128, 128, 0.25);
    border-top-color: rgba(128, 128, 128, 0.25);
    border-bottom-color: rgba(128, 128, 128, 0.25);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ListDrawer__Controls {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.ListDrawer__Number {
    flex-grow: 1;
    min-width: 24px;
    opacity: 0.7;
    -unity-font-style: bold;
}

.ListDrawer__Button {
    min-height: 24px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 4px;
    margin-right: 0;
    flex-shrink: 0;
}

.ListDrawer__Button:disabled {
    opacity: 0.4;
}

.ListDrawer__MoveButton {
    width: 26px;
    padding-left: 0;
    padding-right: 0;
}

.ListDrawer__RemoveButton {
    padding-left: 8px;
    padding-right: 8px;
}

.ListDrawer__Content {
    min-width: 0;
}

.ListDrawer__Content .unity-base-field {
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
}

.ListDrawer__AddButton {
    align-self: flex-start;
    min-height: 26px;
    margin-top: 2px;
    margin-left: 0;
    padding-left: 12px;
    padding-right: 12px;
}
